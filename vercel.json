{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "indiaaibrief.com" }],
      "destination": "https://www.indiaaibrief.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/editorial?job=rss-high",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/editorial?job=rss-medium",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/editorial?job=scrape",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/editorial?job=morning-brief",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/editorial?job=weekly-roundup",
      "schedule": "30 12 * * 0"
    }
  ]
}
