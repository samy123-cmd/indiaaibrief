# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.indiaaibrief.com

# Supabase Auth + Database — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooled Postgres URI (Transaction/Session pooler)
DATABASE_URL=

# Editorial ingest / Vercel Cron
# Sub-daily crons require Vercel Pro
CRON_SECRET=
INGEST_API_KEY=

# AI drafts via Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Optional: post-publish Telegram share
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dual-write published MDX under content/ in local/dev
EDITORIAL_WRITE_MDX=0

# After linking Supabase, run:
#   npm run db:migrate
#   npm run db:seed
#   npm run db:seed-figures
#   npm run db:promote-admin -- you@email.com

# Razorpay — https://dashboard.razorpay.com → Account & Settings → API Keys
# Key ID looks like rzp_test_… or rzp_live_…  Key Secret is a separate string (NOT rzp_*).
# Put the Key ID in BOTH of these; put the Key Secret only in RAZORPAY_KEY_SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KIT_AMOUNT_PAISE=99900
RAZORPAY_AUDIT_AMOUNT_PAISE=499900
RAZORPAY_BRIEF_PLAN_ID=
DOWNLOAD_TOKEN_SECRET=

# Buttondown Newsletter — https://buttondown.com → Settings → API
# Use https://api.buttondown.com/v1 (not .email). Create an API key with subscriber access.
BUTTONDOWN_API_KEY=
BUTTONDOWN_API_URL=https://api.buttondown.com/v1

# Contact form delivery (at least one required in production)
CONTACT_INBOX=hello@indiaaibrief.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=IndiaAIBrief <onboarding@resend.dev>
CONTACT_WEBHOOK_URL=

# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_API_VERSION=2025-01-01

# Meilisearch — self-hosted or Meilisearch Cloud
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=
NEXT_PUBLIC_MEILI_HOST=http://127.0.0.1:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=

# Plausible Analytics (cookie-less) — self-hosted or plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=indiaaibrief.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_API=https://plausible.io/api/event

# Google Search Console HTML-tag verification (optional; prefer DNS TXT)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Telegram community (optional Phase 1 link)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/indiaaibrief
