# Public site URL (no trailing slash) — must match canonical host (www)
NEXT_PUBLIC_SITE_URL=https://www.indiaaibrief.com

# Supabase Auth + Database — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooled Postgres URI (Transaction/Session pooler)
DATABASE_URL=

# Supabase Auth → URL Configuration:
#   Site URL: https://www.indiaaibrief.com
#   Redirect allow-list:
#     https://www.indiaaibrief.com/auth/callback
#     http://localhost:3000/auth/callback

# Editorial ingest / Vercel Cron
# Sub-daily crons require Vercel Pro
CRON_SECRET=
INGEST_API_KEY=

# AI drafts via Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Optional: post-publish Telegram share
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dual-write published MDX under content/ in local/dev
EDITORIAL_WRITE_MDX=0

# After linking Supabase, run:
#   npm run db:migrate
#   npm run db:seed
#   npm run db:seed-figures
#   npm run db:promote-admin -- you@email.com

# ---------------------------------------------------------------------------
# Razorpay — https://dashboard.razorpay.com → Account & Settings → API Keys
# ---------------------------------------------------------------------------
# Key ID     = rzp_test_… or rzp_live_…  (public; used by Checkout.js)
# Key Secret = long random string that does NOT start with rzp_ (server only)
#
# Put Key ID in BOTH public + server vars. Put Key Secret ONLY in KEY_SECRET.
# Webhook signing secret: Dashboard → Webhooks → Signing Secret
#   URL: https://www.indiaaibrief.com/api/payments/webhook
#   Events: payment.captured, payment.authorized
# Do NOT put your login password in RAZORPAY_WEBHOOK_SECRET.
#
# Production should use rzp_live_* keys. While still testing on prod, set
# ALLOW_RAZORPAY_TEST_KEYS=1 to silence the warning.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_RAZORPAY_TEST_KEYS=
RAZORPAY_KIT_AMOUNT_PAISE=99900
RAZORPAY_AUDIT_AMOUNT_PAISE=499900
RAZORPAY_BRIEF_PLAN_ID=
# Required on Vercel production — openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Buttondown Newsletter — https://buttondown.com → Settings → API
# Use https://api.buttondown.com/v1 (NOT api.buttondown.email)
# ---------------------------------------------------------------------------
BUTTONDOWN_API_KEY=
BUTTONDOWN_API_URL=https://api.buttondown.com/v1

# Contact form delivery (at least one required in production)
CONTACT_INBOX=hello@indiaaibrief.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=IndiaAIBrief <onboarding@resend.dev>
CONTACT_WEBHOOK_URL=

# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_API_VERSION=2025-01-01

# Meilisearch — self-hosted or Meilisearch Cloud
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=
NEXT_PUBLIC_MEILI_HOST=http://127.0.0.1:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=

# Plausible Analytics (cookie-less) — self-hosted or plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=indiaaibrief.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_API=https://plausible.io/api/event

# Google Search Console HTML-tag verification (optional; prefer DNS TXT)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# IndexNow (Bing + partners) — key file must also exist at public/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=e8fb5aa82fc64eef87da5bdcc606a150
# Optional: protect POST /api/indexnow (falls back to CRON_SECRET)
# INDEXNOW_SUBMIT_SECRET=

# Telegram community (optional Phase 1 link)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/indiaaibrief
